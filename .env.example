WSS_STRATEGY_BUFFER=8192
WSS_READ_LIMIT_BYTES=1048576
STRATEGY_WORKERS=16
STRATEGY_QUEUE_BUFFER=512
STRATEGY_SHARD_BACKLOG=2048
