ROBINHOOD_MONITOR_PRIVATE_KEY_EXPORT_PASSWORD=basketball.1234
PRIVATE_KEY_ENCRYPTION_KEY=change-this-32-byte-key
LOCAL_STORAGE_PATH=/data/uploads
STORAGE_DRIVER=local
MAX_PHOTO_SIZE_MB=8
ALLOWED_PHOTO_TYPES=image/jpeg,image/png,image/webp,image/heic
PONS_V2_DEPLOYMENT_LISTENER_ENABLED=false
UNISWAP_V4_SWAP_LISTENER_ENABLED=true
UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
UNISWAP_V4_UNIVERSAL_ROUTER_ADDRESS=0x8876789976decbfcbbbe364623c63652db8c0904
